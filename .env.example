# =====================================================================
# TRUSTMESH Environment Configuration Template
# Copy this file to .env and adjust variables as required
# =====================================================================

# Execution environment: 'development' | 'production' | 'test'
TRUSTMESH_ENV=development

# Architecture mode: 'distributed' (separate microservice nodes) | 'test_inprocess' (in-memory test adapter)
TRUSTMESH_MODE=distributed

# Internal service communication key for authenticating inter-node RPC
INTERNAL_SERVICE_KEY=trustmesh-internal-node-secret-2026

# Secret key for signing session bearer tokens (Must change in production)
TRUSTMESH_SECRET_KEY=trustmesh-local-evaluation-insecure-demo-secret-key-2026

# Algorithm for session tokens
TRUSTMESH_AUTH_ALGORITHM=HS256

# Allow 1-click persona switching for local demonstrations (Forbidden in production)
TRUSTMESH_ALLOW_DEMO_SHORTCUTS=true

# Server Ports
COORDINATOR_PORT=8000
BANK_A_PORT=8001
INSURER_B_PORT=8002
LENDER_C_PORT=8003

# Distributed Node URLs for Split Learning RPC
BANK_A_URL=http://127.0.0.1:8001
INSURER_B_URL=http://127.0.0.1:8002
LENDER_C_URL=http://127.0.0.1:8003

# Frontend API Base URL for Vite Client
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Synthetic Data Parameters
SYNTHETIC_DATA_SEED=42
TOTAL_SYNTHETIC_RECORDS=1500

# Differential Privacy Parameters
DEFAULT_EPSILON=1.5
DEFAULT_DELTA=1e-5
CLIP_NORM=1.0
